```python
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression

from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report,
    ConfusionMatrixDisplay
)

print("=" * 70)
print("SPAM EMAIL CLASSIFICATION USING LOGISTIC REGRESSION")
print("=" * 70)

url = "https://raw.githubusercontent.com/justmarkham/pycon-2016-tutorial/master/data/sms.tsv"

df = pd.read_csv(
    url,
    sep="\t",
    header=None,
    names=["label", "message"]
)

print("\nDataset downloaded successfully!")
print("\nFirst 5 rows:")
print(df.head())
print("\nDataset shape:")
print(df.shape)

df = df.dropna()

df["label"] = df["label"].map({
    "ham": 0,
    "spam": 1
})

df = df.dropna()
df["label"] = df["label"].astype(int)

print("\nClass Distribution:")
print(df["label"].value_counts())

print("\nNon-Spam (Ham):", sum(df["label"] == 0))
print("Spam:", sum(df["label"] == 1))

X = df["message"]
y = df["label"]

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("\nTraining samples:", len(X_train))
print("Testing samples :", len(X_test))

vectorizer = TfidfVectorizer(
    lowercase=True,
    stop_words="english",
    ngram_range=(1, 2),
    min_df=2,
    max_df=0.95,
    sublinear_tf=True
)

X_train_tfidf = vectorizer.fit_transform(X_train)
X_test_tfidf = vectorizer.transform(X_test)

print("\nTF-IDF feature extraction completed.")
print("Training feature matrix:", X_train_tfidf.shape)
print("Testing feature matrix :", X_test_tfidf.shape)

model = LogisticRegression(max_iter=1000)

model.fit(
    X_train_tfidf,
    y_train
)

print("\nOriginal Logistic Regression model trained successfully.")

y_pred = model.predict(X_test_tfidf)
y_probability = model.predict_proba(X_test_tfidf)[:, 1]

accuracy = accuracy_score(y_test, y_pred)
precision = precision_score(y_test, y_pred, zero_division=0)
recall = recall_score(y_test, y_pred, zero_division=0)
f1 = f1_score(y_test, y_pred, zero_division=0)

print("\n" + "=" * 70)
print("ORIGINAL MODEL RESULTS")
print("=" * 70)

print("Accuracy :", round(accuracy * 100, 2), "%")
print("Precision:", round(precision * 100, 2), "%")
print("Recall   :", round(recall * 100, 2), "%")
print("F1 Score :", round(f1 * 100, 2), "%")

print("\nClassification Report:")
print(
    classification_report(
        y_test,
        y_pred,
        target_names=["Non-Spam", "Spam"],
        zero_division=0
    )
)

cm = confusion_matrix(y_test, y_pred)

print("\nConfusion Matrix:")
print(cm)

tn, fp, fn, tp = cm.ravel()

print("\nTrue Negative :", tn)
print("False Positive:", fp)
print("False Negative:", fn)
print("True Positive :", tp)

disp = ConfusionMatrixDisplay(
    confusion_matrix=cm,
    display_labels=["Non-Spam", "Spam"]
)

disp.plot()
plt.title("Original Logistic Regression - Confusion Matrix")
plt.show()

print("\n" + "=" * 70)
print("DECISION BOUNDARY ANALYSIS")
print("=" * 70)

print("Default threshold = 0.50")
print("Probability >= 0.50 -> Spam")
print("Probability < 0.50 -> Non-Spam")

print("\nFirst 10 Spam probabilities:")
print(np.round(y_probability[:10], 4))

threshold_50 = 0.50

y_pred_50 = (
    y_probability >= threshold_50
).astype(int)

cm_50 = confusion_matrix(y_test, y_pred_50)

tn50, fp50, fn50, tp50 = cm_50.ravel()

print("\nThreshold = 0.50")
print("True Negatives :", tn50)
print("False Positives:", fp50)
print("False Negatives:", fn50)
print("True Positives :", tp50)

threshold_30 = 0.30

y_pred_30 = (
    y_probability >= threshold_30
).astype(int)

accuracy_30 = accuracy_score(y_test, y_pred_30)
precision_30 = precision_score(y_test, y_pred_30, zero_division=0)
recall_30 = recall_score(y_test, y_pred_30, zero_division=0)
f1_30 = f1_score(y_test, y_pred_30, zero_division=0)

cm_30 = confusion_matrix(y_test, y_pred_30)

tn30, fp30, fn30, tp30 = cm_30.ravel()

print("\n" + "=" * 70)
print("MODEL AFTER THRESHOLD OPTIMIZATION")
print("=" * 70)

print("New Threshold:", threshold_30)
print("Accuracy :", round(accuracy_30 * 100, 2), "%")
print("Precision:", round(precision_30 * 100, 2), "%")
print("Recall   :", round(recall_30 * 100, 2), "%")
print("F1 Score :", round(f1_30 * 100, 2), "%")
print("\nFalse Negatives:", fn30)

balanced_model = LogisticRegression(
    class_weight="balanced",
    max_iter=1000
)

balanced_model.fit(
    X_train_tfidf,
    y_train
)

print("\nBalanced Logistic Regression model trained successfully.")

y_pred_balanced = balanced_model.predict(X_test_tfidf)

accuracy_bal = accuracy_score(y_test, y_pred_balanced)
precision_bal = precision_score(y_test, y_pred_balanced, zero_division=0)
recall_bal = recall_score(y_test, y_pred_balanced, zero_division=0)
f1_bal = f1_score(y_test, y_pred_balanced, zero_division=0)

cm_bal = confusion_matrix(y_test, y_pred_balanced)

tn_bal, fp_bal, fn_bal, tp_bal = cm_bal.ravel()

print("\n" + "=" * 70)
print("BALANCED MODEL RESULTS")
print("=" * 70)

print("Accuracy :", round(accuracy_bal * 100, 2), "%")
print("Precision:", round(precision_bal * 100, 2), "%")
print("Recall   :", round(recall_bal * 100, 2), "%")
print("F1 Score :", round(f1_bal * 100, 2), "%")
print("\nFalse Negatives:", fn_bal)

disp2 = ConfusionMatrixDisplay(
    confusion_matrix=cm_bal,
    display_labels=["Non-Spam", "Spam"]
)

disp2.plot()
plt.title("Balanced Logistic Regression - Confusion Matrix")
plt.show()

results = pd.DataFrame({
    "Model": [
        "Original Threshold 0.50",
        "Optimized Threshold 0.30",
        "Balanced Logistic Regression"
    ],
    "Accuracy": [
        accuracy,
        accuracy_30,
        accuracy_bal
    ],
    "Precision": [
        precision,
        precision_30,
        precision_bal
    ],
    "Recall": [
        recall,
        recall_30,
        recall_bal
    ],
    "F1 Score": [
        f1,
        f1_30,
        f1_bal
    ],
    "False Negatives": [
        fn,
        fn30,
        fn_bal
    ]
})

results["Accuracy"] *= 100
results["Precision"] *= 100
results["Recall"] *= 100
results["F1 Score"] *= 100

print("\n" + "=" * 70)
print("FINAL MODEL COMPARISON")
print("=" * 70)

print(results.round(2).to_string(index=False))

plot_data = results.set_index("Model")[
    ["Accuracy", "Precision", "Recall", "F1 Score"]
]

plot_data.plot(
    kind="bar",
    figsize=(12, 6)
)

plt.title("Comparison of Spam Classification Models")
plt.xlabel("Model")
plt.ylabel("Score (%)")
plt.ylim(0, 105)
plt.xticks(rotation=20, ha="right")
plt.grid(axis="y", alpha=0.3)
plt.tight_layout()
plt.show()

plt.figure(figsize=(10, 5))

plt.bar(
    results["Model"],
    results["False Negatives"]
)

plt.title("False Negative Comparison")
plt.xlabel("Model")
plt.ylabel("Number of False Negatives")
plt.xticks(rotation=20, ha="right")
plt.tight_layout()
plt.show()

def predict_message(message, threshold=0.30):
    message_tfidf = vectorizer.transform([message])

    probability = balanced_model.predict_proba(
        message_tfidf
    )[0][1]

    if probability >= threshold:
        prediction = "SPAM"
    else:
        prediction = "NON-SPAM"

    print("\n----------------------------------------")
    print("Message:")
    print(message)
    print("Spam Probability:", round(probability * 100, 2), "%")
    print("Prediction:", prediction)
    print("----------------------------------------")

predict_message(
    "Congratulations! You have won a free prize. Click the link now to claim your reward!"
)

predict_message(
    "Hi, please submit your assignment before tomorrow."
)

predict_message(
    "URGENT! You have won 1000 dollars. Claim your reward immediately!"
)

predict_message(
    "Hey, are we meeting at college tomorrow?"
)

print("\n" + "=" * 70)
print("PROGRAM COMPLETED SUCCESSFULLY")
print("=" * 70)
```
