import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.datasets import load_digits
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.mixture import GaussianMixture
from sklearn.decomposition import PCA
from sklearn.metrics import (
    silhouette_score,
    adjusted_rand_score,
    normalized_mutual_info_score
)

digits = load_digits()

X = digits.data
y = digits.target

print("DIGITS DATASET")
print("Number of Samples:", X.shape[0])
print("Number of Features:", X.shape[1])

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

k = 10

kmeans = KMeans(
    n_clusters=k,
    random_state=42,
    n_init=10
)

kmeans_labels = kmeans.fit_predict(X_scaled)

gmm = GaussianMixture(
    n_components=k,
    covariance_type="full",
    random_state=42
)

gmm_labels = gmm.fit_predict(X_scaled)

kmeans_silhouette = silhouette_score(
    X_scaled,
    kmeans_labels
)

gmm_silhouette = silhouette_score(
    X_scaled,
    gmm_labels
)

kmeans_ari = adjusted_rand_score(
    y,
    kmeans_labels
)

gmm_ari = adjusted_rand_score(
    y,
    gmm_labels
)

kmeans_nmi = normalized_mutual_info_score(
    y,
    kmeans_labels
)

gmm_nmi = normalized_mutual_info_score(
    y,
    gmm_labels
)

print("\nCLUSTERING RESULTS")

print("\nK-MEANS")
print("Silhouette Score:", round(kmeans_silhouette, 4))
print("Adjusted Rand Index:", round(kmeans_ari, 4))
print("Normalized Mutual Information:", round(kmeans_nmi, 4))

print("\nGAUSSIAN MIXTURE MODEL - EM")
print("Silhouette Score:", round(gmm_silhouette, 4))
print("Adjusted Rand Index:", round(gmm_ari, 4))
print("Normalized Mutual Information:", round(gmm_nmi, 4))

comparison = pd.DataFrame({
    "Method": ["K-Means", "Gaussian Mixture Model"],
    "Silhouette Score": [
        kmeans_silhouette,
        gmm_silhouette
    ],
    "Adjusted Rand Index": [
        kmeans_ari,
        gmm_ari
    ],
    "Normalized Mutual Information": [
        kmeans_nmi,
        gmm_nmi
    ]
})

print("\nCOMPARISON TABLE")
print(comparison)

pca = PCA(n_components=2)

X_pca = pca.fit_transform(X_scaled)

plt.figure(figsize=(10, 7))

plt.scatter(
    X_pca[:, 0],
    X_pca[:, 1],
    c=kmeans_labels,
    s=15
)

plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.title("Digits Clusters using K-Means after PCA")
plt.colorbar(label="Cluster")
plt.grid(True)
plt.show()

plt.figure(figsize=(10, 7))

plt.scatter(
    X_pca[:, 0],
    X_pca[:, 1],
    c=gmm_labels,
    s=15
)

plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.title("Digits Clusters using GMM-EM after PCA")
plt.colorbar(label="Cluster")
plt.grid(True)
plt.show()

methods = ["K-Means", "GMM-EM"]

silhouette_values = [
    kmeans_silhouette,
    gmm_silhouette
]

ari_values = [
    kmeans_ari,
    gmm_ari
]

nmi_values = [
    kmeans_nmi,
    gmm_nmi
]

plt.figure(figsize=(8, 5))

x = np.arange(len(methods))
width = 0.25

plt.bar(
    x - width,
    silhouette_values,
    width,
    label="Silhouette"
)

plt.bar(
    x,
    ari_values,
    width,
    label="ARI"
)

plt.bar(
    x + width,
    nmi_values,
    width,
    label="NMI"
)

plt.xticks(x, methods)
plt.ylabel("Score")
plt.title("K-Means vs GMM-EM Performance")
plt.legend()
plt.grid(axis="y")
plt.show()

print("\nCONCLUSION")

if gmm_ari > kmeans_ari:
    print("GMM-EM performs better than K-Means based on ARI.")
else:
    print("K-Means performs better than GMM-EM based on ARI.")

if gmm_silhouette > kmeans_silhouette:
    print("GMM-EM has better cluster separation based on Silhouette Score.")
else:
    print("K-Means has better cluster separation based on Silhouette Score.")
